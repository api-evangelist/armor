{
  "opencollection": "1.0.0",
  "info": {
    "name": "Accounts Tours API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.armor.com/auth/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Tours",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get tour preferences",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.secure-dev.services/users/:userId/tours",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The identifier of the user for which tour preferences are being requested."
              }
            ]
          },
          "docs": "Get the tour preferences for the specified user."
        },
        {
          "info": {
            "name": "Update tour preferences",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://accounts.api.secure-dev.services/users/:userId/tours",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The identifier of the user for which tour preferences are being updated."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the tour preferences of the specified user."
        }
      ]
    }
  ],
  "bundled": true
}