          "id": "f240799c-f8f8-496d-8da9-239f3c9c3716",
          "name": "Exchange authorization code for access token",
          "request": {
            "name": "Exchange authorization code for access token",
            "description": {
              "content": "Exchanges an authorization code for an access token and ID token.\nThe authorization code must be used within 2 minutes of issuance.\nAccess tokens are valid for 15 minutes.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
