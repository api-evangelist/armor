  "item": [
    {
      "id": "cd199f7d-5eca-44c2-9f8b-9f37d8858ac3",
      "name": "Authentication",
      "description": {
        "content": "FH-AUTH authentication flow endpoints.\n\n## Flow Overview\n1. POST `/auth/authorize` with credentials → receive authorization code\n2. POST `/auth/token` with code → receive access token\n3. Use `Authorization: FH-AUTH {token}` header for API calls\n4. POST `/auth/token/reissue` to refresh expired tokens\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1804b791-2abe-4c70-b047-bb3a846c587d",
          "name": "Get authorization code",
          "request": {
            "name": "Get authorization code",
            "description": {
              "content": "Authenticates user credentials and returns an authorization code.\nThe code must be exchanged for an access token within 2 minutes.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<email>\",\n  \"password\": \"<password>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "f012943b-2919-4143-afd1-b89aacd1dbb6",
