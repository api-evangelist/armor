{
  "opencollection": "1.0.0",
  "info": {
    "name": "Notifications Preferences API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.armor.com/auth/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Preferences",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User Preferences",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://notifications.api.secure-dev.services/preferences/:type",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "path",
                "description": "Filter by notification type."
              }
            ]
          },
          "docs": "Get the user preferences of the given type for the currently logged-in user."
        },
        {
          "info": {
            "name": "Create or Update User Preferences",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://notifications.api.secure-dev.services/preferences/:type",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "path",
                "description": "The notification type."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update a notification preference of the given type for the currently logged-in user."
        },
        {
          "info": {
            "name": "List Preferences for Organization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://notifications.api.secure-dev.services/preferences/actions/list-for-org",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Return a list of all users and their preferences for a given organization ID."
        }
      ]
    }
  ],
  "bundled": true
}