{
  "opencollection": "1.0.0",
  "info": {
    "name": "Armor Compliance Assessments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.armor.com/authorize",
      "accessTokenUrl": "https://auth.armor.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Assessments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve list of assessment accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://compliance.api.secure-prod.services/assessments/accounts"
          },
          "docs": "Retrieve list of assessment accounts"
        },
        {
          "info": {
            "name": "Create assessment account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://compliance.api.secure-prod.services/assessments/accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create assessment account"
        },
        {
          "info": {
            "name": "Update assessment account",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://compliance.api.secure-prod.services/assessments/accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Assessment account ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update assessment account"
        },
        {
          "info": {
            "name": "Cancel assessment account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://compliance.api.secure-prod.services/assessments/accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Assessment account ID"
              }
            ]
          },
          "docs": "Cancel assessment account"
        }
      ]
    }
  ],
  "bundled": true
}