        {
          "id": "e8214688-5012-45ab-8c2d-fe4488e953a1",
          "name": "Update an ACL",
          "request": {
            "name": "Update an ACL",
            "description": {
              "content": "Update an Access Control List (ACL) that manages access to your log endpoints.\n\nThis update action requires an `If-Unmodified-Since` precondition header which must match\nthe `version` property of the request body. If the entity has been modified since the\nsupplied version, a `412` response will be returned. If this header is absent from the\nrequest a `400` response will be returned.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "logs",
                "acls",
                ":aclId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "aclId",
                  "description": "(Required) The unique identifier of the Log ACL being updated."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Version header for concurrency control",
                "key": "If-Unmodified-Since",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aclId\": \"<uuid>\",\n  \"allowedNetworks\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"maxAllowedNetworks\": \"<integer>\",\n  \"version\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
