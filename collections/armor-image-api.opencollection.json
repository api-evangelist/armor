{
  "opencollection": "1.0.0",
  "info": {
    "name": "Container Security Image API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.armor.com/auth/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Image",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Images",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://compliance.api.secure-dev.services/containers/images",
            "headers": [
              {
                "name": "x-account-context",
                "value": "4"
              }
            ]
          },
          "docs": "Returns a list of all images."
        },
        {
          "info": {
            "name": "Get Image Detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://compliance.api.secure-dev.services/containers/images/:id",
            "headers": [
              {
                "name": "x-account-context",
                "value": "4"
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Image ID"
              }
            ]
          },
          "docs": "Returns details for a specific image."
        }
      ]
    }
  ],
  "bundled": true
}