{
  "opencollection": "1.0.0",
  "info": {
    "name": "Accounts Cloud Connections API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.armor.com/auth/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Cloud Connections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get cloud connections by Account Id",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accounts.api.secure-dev.services/cloud-connections",
            "headers": [
              {
                "name": "x-account-context",
                "value": "4"
              }
            ],
            "params": [
              {
                "name": "searchText",
                "value": "",
                "type": "query",
                "description": "Search text to filter cloud connections."
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query",
                "description": "Current page number."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of cloud connections to be displayed on page."
              },
              {
                "name": "sortFld",
                "value": "",
                "type": "query",
                "description": "Cloud connections sorting field."
              },
              {
                "name": "sortDir",
                "value": "",
                "type": "query",
                "description": "Cloud connection sort order direction (asc/desc)."
              },
              {
                "name": "filterBy",
                "value": "",
                "type": "query",
                "description": "Cloud connections filter by provider type."
              }
            ]
          },
          "docs": "Retrieve All Cloud Connections based on Account Id."
        },
        {
          "info": {
            "name": "Get All Connection Service Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.secure-dev.services/cloud-connection/service-types"
          },
          "docs": "Retrieve All Connection Service Types."
        },
        {
          "info": {
            "name": "Get cloud connection detail by connection Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.secure-dev.services/cloud-connections/:connectionId",
            "params": [
              {
                "name": "connectionId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the cloud connection."
              }
            ]
          },
          "docs": "Retrieve cloud connection detail by connection Id."
        }
      ]
    }
  ],
  "bundled": true
}