{
  "opencollection": "1.0.0",
  "info": {
    "name": "Container Security Sensor API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.armor.com/auth/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Sensor",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Sensors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://compliance.api.secure-dev.services/containers/sensors",
            "headers": [
              {
                "name": "x-account-context",
                "value": "4"
              }
            ]
          },
          "docs": "Returns list of currently-installed container sensors."
        }
      ]
    }
  ],
  "bundled": true
}