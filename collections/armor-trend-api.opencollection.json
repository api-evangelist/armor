{
  "opencollection": "1.0.0",
  "info": {
    "name": "Incident Management Trend API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.armor.com/auth/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Trend",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Details of a Trend AV report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://security-detections.api.secure-dev.services/trend/av-report",
            "headers": [
              {
                "name": "x-account-context",
                "value": "4"
              }
            ],
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The offset value to fetch next records."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The value to limit the number of records fetched."
              },
              {
                "name": "orderby",
                "value": "",
                "type": "query",
                "description": "Sort direction. Example: `id desc`."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort by column. Example: `VM Name`, `Report Date`, etc."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search by VM Name.\nNote: Fields are case sensitive.\n"
              }
            ]
          },
          "docs": "Get the details of a Trend AV report."
        }
      ]
    }
  ],
  "bundled": true
}