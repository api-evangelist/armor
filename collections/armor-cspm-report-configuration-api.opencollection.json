{
  "opencollection": "1.0.0",
  "info": {
    "name": "Armor Compliance CSPM Report Configuration API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.armor.com/authorize",
      "accessTokenUrl": "https://auth.armor.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "CSPM Report Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get report configuration by provider",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://compliance.api.secure-prod.services/cspm/report/configuration",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "query",
                "description": "Provider type"
              }
            ]
          },
          "docs": "Get report configuration by provider"
        },
        {
          "info": {
            "name": "Create CSPM report configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://compliance.api.secure-prod.services/cspm/report/configuration",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create CSPM report configuration"
        }
      ]
    }
  ],
  "bundled": true
}