{
  "opencollection": "1.0.0",
  "info": {
    "name": "Armor Compliance CSPM Summary API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.armor.com/authorize",
      "accessTokenUrl": "https://auth.armor.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "CSPM Summary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get CSPM CloudConnector summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://compliance.api.secure-prod.services/cspm/summary"
          },
          "docs": "Get CSPM CloudConnector summary"
        }
      ]
    }
  ],
  "bundled": true
}