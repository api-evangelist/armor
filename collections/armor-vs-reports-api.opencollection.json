{
  "opencollection": "1.0.0",
  "info": {
    "name": "Armor Compliance VS Reports API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.armor.com/authorize",
      "accessTokenUrl": "https://auth.armor.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "VS Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate new vulnerability report",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://compliance.api.secure-prod.services/vulnerability-scan/vulnerability-import-scan",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate new vulnerability report"
        },
        {
          "info": {
            "name": "List vulnerability scan summary reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://compliance.api.secure-prod.services/vulnerability-scan/summary-reports"
          },
          "docs": "List vulnerability scan summary reports"
        },
        {
          "info": {
            "name": "Generate detailed vulnerabilities report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://compliance.api.secure-prod.services/vulnerability-scan/generate-report"
          },
          "docs": "Generate detailed vulnerabilities report"
        },
        {
          "info": {
            "name": "Get detailed vulnerabilities report for CSV export",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://compliance.api.secure-prod.services/vulnerability-scan/get-export-data"
          },
          "docs": "Get detailed vulnerabilities report for CSV export"
        }
      ]
    }
  ],
  "bundled": true
}