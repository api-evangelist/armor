{
  "opencollection": "1.0.0",
  "info": {
    "name": "Infrastructure Management Toolbox API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.armor.com/auth/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Toolbox",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Virtual Machines",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://infrastructure.api.secure-dev.services/virtual-machines",
            "params": [
              {
                "name": "top",
                "value": "",
                "type": "query",
                "description": "Maximum records for request."
              },
              {
                "name": "skip",
                "value": "",
                "type": "query",
                "description": "Offset position."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Available filters like Products, Status, Account."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Free text to search Task Name, etc."
              },
              {
                "name": "orderby",
                "value": "",
                "type": "query",
                "description": "Sort direction. Example: id desc."
              }
            ]
          },
          "docs": "Get a list of virtual machines, including completed ones."
        },
        {
          "info": {
            "name": "Get Operating Systems",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://infrastructure.api.secure-dev.services/operating-systems"
          },
          "docs": "Get operating systems."
        }
      ]
    }
  ],
  "bundled": true
}